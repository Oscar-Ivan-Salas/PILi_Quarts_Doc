# =============================================
# N04 Binary Factory - Variables de Entorno
# =============================================
# Copia este archivo como .env y ajusta los valores

# Puerto del Backend (FastAPI / Uvicorn)
PORT=8005
HOST=0.0.0.0

# Modo de ejecución
DEBUG=false
LOG_LEVEL=INFO

# CORS - Orígenes permitidos (separados por coma)
# En desarrollo: localhost:5173
# En producción: https://tudominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (opcional - para persistencia en la nube)
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_KEY=eyJhbGci...

# Playwright (PDF Generation)
# Dejar vacío para usar Chromium instalado por defecto
# PLAYWRIGHT_BROWSERS_PATH=/ruta/personalizada
